import android.content.Intent
import android.os.Bundle
import android.provider.Settings
import android.widget.Button
import android.widget.TextView
import androidx.appcompat.app.AppCompatActivity

class MainActivity : AppCompatActivity() {

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        val status = findViewById<TextView>(R.id.status)
        val btnAccess = findViewById<Button>(R.id.btnAccess)
        val btnStart = findViewById<Button>(R.id.btnStart)
        val btnStop = findViewById<Button>(R.id.btnStop)

        btnAccess.setOnClickListener {
            startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
        }

        btnStart.setOnClickListener {
            val svc = AutoClickService.instance
            if (svc == null) {
                status.text = "❌ Сначала включи Accessibility"
                return@setOnClickListener
            }
            svc.startClicking()
            status.text = "✅ Тапы запущены"
        }

        btnStop.setOnClickListener {
            AutoClickService.instance?.stopClicking()
            status.text = "⏸ Тапы остановлены"
        }
    }

    override fun onResume() {
        super.onResume()
        val status = findViewById<TextView>(R.id.status)
        status.text = if (AutoClickService.instance != null)
            "✅ Accessibility подключён"
        else
            "⚠️ Accessibility не включён"
    }
} package com.afk.clicker

import android.accessibilityservice.AccessibilityService
import android.accessibilityservice.GestureDescription
import android.graphics.Path
import android.os.Handler
import android.os.Looper
import android.util.Log
import android.view.accessibility.AccessibilityEvent
import kotlin.random.Random

class AutoClickService : AccessibilityService() {

    companion object {
        var instance: AutoClickService? = null
        var isRunning = false
        var tapCount = 0
    }

    private val handler = Handler(Looper.getMainLooper())
    private var active = false

    override fun onServiceConnected() {
        super.onServiceConnected()
        instance = this
        Log.d("AFK", "Accessibility подключён")
        if (isRunning) startClicking()
    }

    override fun onAccessibilityEvent(event: AccessibilityEvent?) {}
    override fun onInterrupt() {}

    fun startClicking() {
        if (active) return
        active = true
        isRunning = true
        scheduleNextTap()
    }

    fun stopClicking() {
        active = false
        isRunning = false
        handler.removeCallbacksAndMessages(null)
    }

    private fun scheduleNextTap() {
        if (!active) return

        val prefs = Prefs(this)
        var delay = Random.nextLong(prefs.minInterval, prefs.maxInterval)

        if (Random.nextInt(100) < prefs.fatigueChance) {
            delay += Random.nextLong(3000, 9000)
        }

        handler.postDelayed({ performTap() }, delay)
    }

    private fun performTap() {
        if (!active) return

        val dm = resources.displayMetrics
        val x = Random.nextFloat() * (dm.widthPixels - 200) + 100f
        val y = Random.nextFloat() * (dm.heightPixels - 400) + 200f

        val path = Path().apply { moveTo(x, y) }
        val gesture = GestureDescription.Builder()
            .addStroke(GestureDescription.StrokeDescription(path, 0, 80))
            .build()

        dispatchGesture(gesture, object : GestureResultCallback() {
            override fun onCompleted(gestureDescription: GestureDescription?) {
                tapCount++
                Log.d("AFK", "Тап #$tapCount в ($x, $y)")
            }
            override fun onCancelled(gestureDescription: GestureDescription?) {
                Log.w("AFK", "Тап отменён")
            }
        }, null)

        scheduleNextTap()
    }

    override fun onDestroy() {
        super.onDestroy()
        instance = null
        stopClicking()
    }
} package com.afk.clicker

import android.content.Context

class Prefs(ctx: Context) {
    private val sp = ctx.getSharedPreferences("afk", Context.MODE_PRIVATE)

    var minInterval: Long
        get() = sp.getLong("min", 1500)
        set(v) = sp.edit().putLong("min", v).apply()

    var maxInterval: Long
        get() = sp.getLong("max", 7000)
        set(v) = sp.edit().putLong("max", v).apply()

    var fatigueChance: Int
        get() = sp.getInt("fatigue", 10)
        set(v) = sp.edit().putInt("fatigue", v).apply()
}
